---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title | xml_escape }}</title>
    <description>{{ site.description | xml_escape }}</description>
    <link>{{ site.url | xml_escape }}</link>
    <atom:link href="{{ '/feed.xml' | absolute_url | xml_escape }}" rel="self" type="application/rss+xml" />
    {% assign items = site | feed_items %}
    {% for item in items %}
      <item>
        <title>{{ item.title | xml_escape }}</title>
        <description>{{ item.description | xml_escape }}</description>
        <pubDate>{{ item.date | date_to_rfc822 }}</pubDate>
        <link>{{ item.url | absolute_url | xml_escape }}</link>
        {% if item.permalink %}
          <guid isPermaLink="true">{{ item.guid | absolute_url | xml_escape }}</guid>
        {% else %}
          <guid isPermaLink="false">{{ item.guid | xml_escape }}</guid>
        {% endif %}
      </item>
    {% endfor %}
  </channel>
</rss>
