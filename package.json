{
  "private": true,
  "scripts": {
    "diagrams:build": "ruby scripts/build_diagrams.rb",
    "diagrams:watch": "ruby scripts/build_diagrams.rb --watch",
    "build": "npm run diagrams:build && npm run css:build && bundle exec jekyll build",
    "test:diagrams": "ruby tests/diagrams_test.rb && node --test tests/diagram-gallery.test.mjs",
    "css:build": "tailwindcss -i ./_tailwind/main.css -o ./assets/css/main.css --minify",
    "css:watch": "tailwindcss -i ./_tailwind/main.css -o ./assets/css/main.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
